{
  "$defs": {
    "AgentActivity": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "type": "array"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/ImageRef"
          },
          "type": "array"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentToolCall"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "type": "object"
    },
    "AgentAuthenticate": {
      "properties": {
        "methodId": {
          "type": "string"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "sessionId",
        "methodId"
      ],
      "type": "object"
    },
    "AgentAvailableCommand": {
      "properties": {
        "description": {
          "type": "string"
        },
        "inputHint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "inputHint"
      ],
      "type": "object"
    },
    "AgentCommand": {
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "type": "array"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/PromptImage"
          },
          "type": "array"
        },
        "includeContext": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "prompt": {
          "default": "",
          "type": "string"
        },
        "promptProvenance": {
          "type": "string"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    "AgentConfigChoice": {
      "properties": {
        "description": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "name",
        "description",
        "group"
      ],
      "type": "object"
    },
    "AgentConfigOption": {
      "properties": {
        "category": {
          "type": "string"
        },
        "currentValue": true,
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/AgentConfigChoice"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "category",
        "kind",
        "currentValue",
        "options"
      ],
      "type": "object"
    },
    "AgentConfigure": {
      "additionalProperties": false,
      "properties": {
        "configId": {
          "type": "string"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        },
        "value": true
      },
      "required": [
        "sessionId",
        "configId",
        "value"
      ],
      "type": "object"
    },
    "AgentPermission": {
      "properties": {
        "options": {
          "items": {
            "$ref": "#/$defs/PermissionChoice"
          },
          "type": "array"
        },
        "requestId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "toolCallId": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "title",
        "toolCallId",
        "options"
      ],
      "type": "object"
    },
    "AgentPlan": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/AgentPlanEntry"
          },
          "type": "array"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "type": "object"
    },
    "AgentPlanEntry": {
      "properties": {
        "content": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "status",
        "priority"
      ],
      "type": "object"
    },
    "AgentStart": {
      "properties": {
        "adapterProfile": {
          "type": "string"
        },
        "arguments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "type": "array"
        },
        "authMethod": {
          "description": "Optional explicit SDK authentication method. Existing native login is default.",
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "default": "",
          "type": "string"
        },
        "connectOnly": {
          "description": "Connect and discover configuration without making an inference request.",
          "type": "boolean"
        },
        "executable": {
          "description": "Host-selected absolute executable; never read from repository config.",
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/PromptImage"
          },
          "type": "array"
        },
        "includeContext": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlaySelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "promptProvenance": {
          "type": "string"
        },
        "rewindTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit new conversation in a retained workspace; never upstream resume."
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "executable",
        "prompt"
      ],
      "type": "object"
    },
    "AgentToolCall": {
      "description": "Bounded display data reported by an adapter. Optional fields are replacement\npatches; an empty collection clears the previous value. Diffs are not verified history.",
      "properties": {
        "diffs": {
          "items": {
            "$ref": "#/$defs/AgentToolDiff"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "input": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/AgentToolLocation"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentToolCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AgentToolDiff": {
      "properties": {
        "after": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ],
      "type": "object"
    },
    "AgentToolLocation": {
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "AgentUsage": {
      "properties": {
        "size": {
          "type": "string"
        },
        "used": {
          "description": "Decimal strings retain the precision of provider u64 counters.",
          "type": "string"
        }
      },
      "required": [
        "used",
        "size"
      ],
      "type": "object"
    },
    "AgentView": {
      "properties": {
        "activity": {
          "items": {
            "$ref": "#/$defs/AgentActivity"
          },
          "type": "array"
        },
        "agentInfo": true,
        "authMethods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "availableCommands": {
          "items": {
            "$ref": "#/$defs/AgentAvailableCommand"
          },
          "type": "array"
        },
        "capabilities": true,
        "compatibility": {
          "type": "string"
        },
        "configOptions": {
          "items": {
            "$ref": "#/$defs/AgentConfigOption"
          },
          "type": "array"
        },
        "configurationError": {
          "type": "string"
        },
        "connectionStage": {
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/AgentPermission"
          },
          "type": "array"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "queue": {
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "type": "array"
        },
        "queuePaused": {
          "type": "boolean"
        },
        "recordedOperations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "startupElapsedMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "startupTimingsMs": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "status": {
          "type": "string"
        },
        "subagents": {
          "items": {
            "$ref": "#/$defs/AgentActivity"
          },
          "type": "array"
        },
        "upstreamSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "agentInfo",
        "capabilities",
        "authMethods",
        "activity",
        "permissions"
      ],
      "type": "object"
    },
    "ApplyAction": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "documentStamps": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "planId": {
          "$ref": "#/$defs/MutationKey"
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "planId",
        "candidateId",
        "writersStopped"
      ],
      "type": "object"
    },
    "ApplyPrepare": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "planId": {
          "$ref": "#/$defs/MutationKey"
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "planId",
        "candidateId",
        "writersStopped"
      ],
      "type": "object"
    },
    "ApplyQuery": {
      "additionalProperties": false,
      "properties": {
        "fileIndex": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "planId": {
          "$ref": "#/$defs/MutationKey"
        },
        "rollback": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "planId"
      ],
      "type": "object"
    },
    "ApplyResolve": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "fileIndex": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "planId": {
          "$ref": "#/$defs/MutationKey"
        }
      },
      "required": [
        "planId",
        "fileIndex",
        "content"
      ],
      "type": "object"
    },
    "AttachmentImport": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "AttachmentQuery": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "$ref": "#/$defs/AttachmentRef"
        }
      },
      "required": [
        "attachment"
      ],
      "type": "object"
    },
    "AttachmentRef": {
      "additionalProperties": false,
      "description": "Exact imported file identity, independent of the original source path.",
      "properties": {
        "id": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "mimeType",
        "size"
      ],
      "type": "object"
    },
    "CancelParams": {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "CandidateCheck": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "type": "string"
        },
        "checkId": {
          "$ref": "#/$defs/MutationKey"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeoutSeconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "candidateId",
        "checkId",
        "command",
        "timeoutSeconds",
        "writersStopped"
      ],
      "type": "object"
    },
    "CandidateDecision": {
      "additionalProperties": false,
      "properties": {
        "accept": {
          "type": "boolean"
        },
        "candidateId": {
          "type": "string"
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "candidateId",
        "accept",
        "writersStopped"
      ],
      "type": "object"
    },
    "CandidatePrepare": {
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        },
        "writersStopped": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "writersStopped"
      ],
      "type": "object"
    },
    "CandidateQuery": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidateId": {
          "type": "string"
        },
        "fileIndex": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "candidateId"
      ],
      "type": "object"
    },
    "ContextQuery": {
      "additionalProperties": false,
      "properties": {
        "byteBudget": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contentHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixed": {
          "default": false,
          "type": "boolean"
        },
        "full": {
          "default": false,
          "type": "boolean"
        },
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "line": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "default": "",
          "type": "string"
        },
        "scope": {
          "description": "Segment-aware relative path prefix, applied before ranking.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokenBudget": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ConversationQuery": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        },
        "through": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    "DurableEvent": {
      "properties": {
        "cursor": {
          "$ref": "#/$defs/EventCursor"
        },
        "kind": {
          "description": "Open string: hosts retain unknown event kinds and their opaque payloads.",
          "type": "string"
        },
        "payload": true,
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "cursor",
        "schemaVersion",
        "workspaceId",
        "kind",
        "payload"
      ],
      "type": "object"
    },
    "EngineCapabilities": {
      "properties": {
        "agentSessions": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "idempotentMutations": {
          "type": "boolean"
        },
        "persistentEvents": {
          "type": "boolean"
        }
      },
      "required": [
        "cancellation",
        "persistentEvents",
        "idempotentMutations",
        "agentSessions"
      ],
      "type": "object"
    },
    "EngineEpoch": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "EventCursor": {
      "properties": {
        "sequence": {
          "$ref": "#/$defs/EventSequence"
        },
        "storeId": {
          "$ref": "#/$defs/StoreId"
        }
      },
      "required": [
        "storeId",
        "sequence"
      ],
      "type": "object"
    },
    "EventSequence": {
      "description": "Decimal on the wire: sequences never lose precision in JavaScript hosts.",
      "type": "string"
    },
    "HealthParams": {
      "properties": {
        "waitMs": {
          "default": 0,
          "description": "Optional bounded diagnostic wait for exercising cancellation/deadlines.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "HealthResult": {
      "properties": {
        "engineVersion": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "engineVersion",
        "projectId"
      ],
      "type": "object"
    },
    "HistoryAttachmentQuery": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "$ref": "#/$defs/AttachmentRef"
        },
        "sessionId": {
          "$ref": "#/$defs/SessionId"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "attachment"
      ],
      "type": "object"
    },
    "HistoryContentIds": {
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HistoryQuery": {
      "properties": {
        "after": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "contentIds": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryContentIds"
            },
            {
              "type": "null"
            }
          ]
        },
