<idea-plugin>
    <id>dev.flow.workbench</id>
    <name>Flow</name>
    <vendor>Flow</vendor>
    <description><![CDATA[
        A native agent workbench for reviewing coding-agent changes.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Flow"
                    anchor="right"
                    factoryClass="dev.flow.ui.WorkbenchToolWindowFactory" />
    </extensions>

    <actions>
        <action id="Flow.Spikes.HistoricalDiff"
                class="dev.flow.spikes.HistoricalDiffProbeAction"
                text="Flow Compatibility: Historical Diffs" />
        <action id="Flow.Spikes.Merge"
                class="dev.flow.spikes.MergeProbeAction"
                text="Flow Compatibility: Native Merge" />
        <action id="Flow.Spikes.ProcessLifecycle"
                class="dev.flow.spikes.ProcessLifecycleProbeAction"
                text="Flow Compatibility: Process Lifecycle" />
    </actions>
</idea-plugin>
